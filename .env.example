# Production/default path. This is a real relative-depth model, downloaded on first use.
TERRAFLY_MODEL_ADAPTER=depth-anything-v2
TERRAFLY_MODEL_ID=depth-anything/Depth-Anything-V2-Large-hf
TERRAFLY_DEVICE=auto
TERRAFLY_MAX_UPLOAD_BYTES=26214400
TERRAFLY_MAX_PIXELS=50000000
# Input-dependent processing guard (768 MiB by default).
TERRAFLY_MAX_WORKING_BYTES=805306368
# Large images are aligned and feather-blended in overlapping tiles.
TERRAFLY_TILE_TRIGGER_PIXELS=4194304
TERRAFLY_TILE_SIZE=1024
TERRAFLY_TILE_OVERLAP=128
TERRAFLY_MAX_TILES=256
